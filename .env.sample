# Required
DATABASE_URL=postgresql+asyncpg://monolit:monolit@localhost:5440/monolit
SECRET_KEY=change-me

# Docker compose: the "db" service (the app container builds DATABASE_URL from
# these; the server backups read POSTGRES_USER / POSTGRES_DB)
POSTGRES_USER=monolit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monolit

# First admin created by the seed (without it a password is generated and
# printed once in the container log)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Optional
# DEBUG=false
# TIMEZONE=Europe/Warsaw
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# LOG_LEVEL=INFO
# DAY_CLOSE_ENABLED=true

# Saldo Palet: yesterday's deliveries are imported every morning (empty URL = off).
# The account needs the "reports" permission there (a viewer is enough).
# SALDO_PALET_URL=https://saldo.piatek-magazyn.com
# SALDO_PALET_USERNAME=monolit
# SALDO_PALET_PASSWORD=
# SALDO_PALET_IMPORT_AT=05:00

# Reminder mails (empty host = no mail is sent)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# Put into the mails as a link
# APP_URL=https://monolit.piatek-magazyn.com
