# Required
DATABASE_URL=postgresql+asyncpg://monolit:monolit@localhost:5440/monolit
SECRET_KEY=change-me

# Docker compose: the "db" service (the app container builds DATABASE_URL from
# these; the server backups read POSTGRES_USER / POSTGRES_DB)
POSTGRES_USER=monolit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monolit

# First admin created by the seed (without it a password is generated and
# printed once in the container log)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Optional
# DEBUG=false
# TIMEZONE=Europe/Warsaw
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# LOG_LEVEL=INFO
# DAY_CLOSE_ENABLED=true
